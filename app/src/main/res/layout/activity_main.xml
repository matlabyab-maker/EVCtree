<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mainRootLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="#07142F" android:gravity="fill">
    <LinearLayout android:id="@+id/standaloneActionsRail" android:layout_width="78dp" android:layout_height="match_parent" android:orientation="vertical" android:background="#0B1B38" android:paddingLeft="3dp" android:paddingRight="3dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:elevation="6dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ابزارها" android:textColor="#FFD21F" android:textSize="11sp" android:textStyle="bold" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="5dp" />
        <ScrollView android:id="@+id/standaloneActionsScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:scrollbars="vertical" android:fadeScrollbars="false" android:overScrollMode="ifContentScrolls">
            <LinearLayout android:id="@+id/standaloneActionsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                <Button android:id="@+id/selectSeparateRangesButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="انتخاب تکه‌های جدا" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFCC80" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" android:foreground="@drawable/panel_button_double_border" />
                <Button android:id="@+id/selectContiguousRangeButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="انتخاب تکه‌های چسبیده" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFB74D" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" android:foreground="@drawable/panel_button_double_border" />
                <Button android:id="@+id/openButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="انتخاب ویدیو" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#90CAF9" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/applyStoryboardTimeRangeButton" android:layout_width="72dp" android:layout_height="44dp" android:text="اعمال زمان" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#81CFAE" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/splitOriginalButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="Split" android:textSize="10sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFCC80" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" android:foreground="@drawable/panel_button_double_border" />
                <Button android:id="@+id/outputChangesButton" android:layout_width="72dp" android:layout_height="48dp" android:text="خروجی تغییرات" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFB300" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" />
                <Button android:id="@+id/originalOutputButton" android:layout_width="72dp" android:layout_height="48dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="Original Utpot" android:textSize="8sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFB74D" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:foreground="@drawable/panel_button_double_border" />
                <Button android:id="@+id/mergeButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:text="Merge • چند ویدیو" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#64B5F6" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp"  android:foreground="@drawable/panel_button_double_border"/>
                <Button android:id="@+id/trackPanelButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:text="ترک‌ها" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFD21F" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp"  android:foreground="@drawable/panel_button_double_border"/>
                <Button android:id="@+id/imageSceneSearchButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:text="جست‌وجوی صحنه با عکس" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#D7A6FF" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp"  android:foreground="@drawable/panel_button_double_border"/>

                <Button android:id="@+id/textPlacementButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="متن‌گذاری" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#D7A6FF" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp"  android:foreground="@drawable/panel_button_double_border"/>
                <Button android:id="@+id/overlayVideoPanelButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="ویدیوی رویی" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#64B5F6" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp"  android:foreground="@drawable/panel_button_double_border"/>
                <Button android:id="@+id/colorPanelButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="رنگ‌آمیزی" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#43D9A3" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp"  android:foreground="@drawable/panel_button_double_border"/>
                <Button android:id="@+id/outputFormatButton" android:layout_width="72dp" android:layout_height="44dp" android:text="فرمت: MP4" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#FFE082" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/joinAfterButton" android:layout_width="72dp" android:layout_height="44dp" android:text="Join • افزودن به انتها" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#1E88E5" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/vectorButton" android:layout_width="72dp" android:layout_height="44dp" android:text="Vector" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#70AEFF" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/cropButton" android:layout_width="72dp" android:layout_height="44dp" android:text="Crop" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp"  android:foreground="@drawable/panel_button_double_border"/>
                <Button android:id="@+id/advancedEditButton" android:layout_width="72dp" android:layout_height="44dp" android:text="ویرایش پیشرفته" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#D7A6FF" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp"  android:foreground="@drawable/panel_button_double_border"/>
                <Button android:id="@+id/timeModeButton" android:layout_width="72dp" android:layout_height="44dp" android:text="نمایش زمانی" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/selectAllButton" android:layout_width="72dp" android:layout_height="44dp" android:text="انتخاب همه" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#FFD54F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/clearSelectionButton" android:layout_width="72dp" android:layout_height="44dp" android:text="لغو انتخاب" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#FFF0A6" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/deleteSelectedButton" android:layout_width="72dp" android:layout_height="44dp" android:text="حذف اسلایدها" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#C62828" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/undoButton" android:layout_width="72dp" android:layout_height="44dp" android:text="↶ Undo" android:textSize="9sp" android:textStyle="bold" android:textColor="#07142F" android:backgroundTint="#7986CB" android:minHeight="0dp" android:minWidth="0dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/redoButton" android:layout_width="72dp" android:layout_height="44dp" android:text="Redo ↷" android:textSize="9sp" android:textStyle="bold" android:textColor="#07142F" android:backgroundTint="#B39DDB" android:minHeight="0dp" android:minWidth="0dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                <Button android:id="@+id/globalDeleteButton" android:layout_width="72dp" android:layout_height="48dp" android:text="Delete • حذف عمومی" android:textSize="10sp" android:textStyle="bold" android:textColor="#FFFFFF" android:backgroundTint="#8E1828" android:minHeight="0dp" android:minWidth="0dp" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout android:id="@+id/editorContentColumn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#07142F">
        <ScrollView android:id="@+id/mainScrollView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:scrollbars="vertical" android:fadeScrollbars="false" android:overScrollMode="ifContentScrolls">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#07142F" android:padding="3dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EVC • استودیو ویرایش ویدیو" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:gravity="center" android:paddingTop="0dp" android:paddingBottom="0dp" />
                <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="یک ویدیو انتخاب کنید تا ۱۲۰ فریم در ۸ ردیف ساخته شود" android:textColor="#B9D7FF" android:textSize="9sp" android:gravity="center" android:paddingBottom="1dp" />
                <FrameLayout android:id="@+id/playerContainer" android:layout_width="match_parent" android:layout_height="180dp" android:background="#000000">
                    <VideoView android:id="@+id/videoView" android:layout_width="match_parent" android:layout_height="match_parent" />
                    <ImageView android:id="@+id/playerColorPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="پیش‌نمایش رنگ فریم فعلی" android:visibility="gone" />
                    <TextView android:id="@+id/emptyHint" android:layout_width="match_parent" android:layout_height="match_parent" android:text="▶  پخش‌کنندهٔ EVC" android:textColor="#D7E7FF" android:textSize="20sp" android:gravity="center" android:background="#101F3D" />
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="نوار زمان: کشیدن برای حرکت • دو انگشت برای بزرگ‌نمایی • انتخاب قطعه و برش" android:textColor="#B9D7FF" android:textSize="9sp" android:gravity="center" android:paddingTop="1dp" />
                <com.evc.app.TimelineView android:id="@+id/timelineView" android:layout_width="match_parent" android:layout_height="56dp" android:background="#10213E" />
                <LinearLayout android:id="@+id/trackPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#172B4D" android:padding="4dp" android:layout_marginTop="3dp" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="افزودن و مدیریت ترک‌های صدا، ویدیو و زیرنویس" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:gravity="center" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="3dp">
                        <Button android:id="@+id/addAudioButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="افزودن صدا" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#42A5F5" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                        <Button android:id="@+id/addSubtitleButton" android:layout_width="72dp" android:layout_height="44dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:text="افزودن زیرنویس" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#BBDEFB" android:layout_marginTop="0dp" android:layout_marginBottom="-3dp" android:singleLine="false" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" />
                        <Button android:id="@+id/addVideoTrackButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="3dp" android:text="افزودن ویدیو" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#64B5F6" android:minHeight="0dp" android:minWidth="0dp" />
                    </LinearLayout>
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="نوار ترک‌ها • وسط قطعه را بکشید تا جابه‌جا شود؛ لبه‌ها را بکشید تا کوتاه/بلند شود" android:textColor="#FFD21F" android:textSize="9sp" android:gravity="center" android:paddingTop="3dp" android:paddingBottom="2dp" />
                <com.evc.app.TrackTimelineView android:id="@+id/trackTimelineView" android:layout_width="match_parent" android:layout_height="88dp" android:background="#10213E" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="3dp">
                    <Button android:id="@+id/splitTrackButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="برش ترک در محل پخش" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" />
                    <Button android:id="@+id/deleteTrackButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="3dp" android:text="حذف قطعه" android:textSize="8sp" android:textColor="#FFFFFF" android:backgroundTint="#D84343" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" />
                    <Button android:id="@+id/resetTracksButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="3dp" android:text="پاک‌کردن ترک‌ها" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" />
                </LinearLayout>
                    <Button android:id="@+id/finishTrackPanelButton" android:layout_width="match_parent" android:layout_height="40dp" android:text="پایان و بستن پنجرهٔ ترک‌ها" android:textSize="10sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingTop="1dp" android:paddingBottom="2dp">
                    <Button android:id="@+id/splitTimelineButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="Cut" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" />
                    <Button android:id="@+id/pickStoryboardStartButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="2dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:text="ثبت شروع از پخش" android:textSize="7sp" android:textColor="#07142F" android:backgroundTint="#A5E6C8" />
                    <Button android:id="@+id/pickStoryboardEndButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="2dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:text="ثبت پایان از پخش" android:textSize="7sp" android:textColor="#07142F" android:backgroundTint="#66CDAA" />
                    <Button android:id="@+id/deleteTimelineSegmentButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="2dp" android:text="حذف قطعه انتخابی" android:textSize="7sp" android:textColor="#FFFFFF" android:backgroundTint="#B52C45" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" />
                    <Button android:id="@+id/restoreTimelineButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="2dp" android:text="بازگردانی قطعات" android:textSize="7sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/freeCropControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:gravity="center" android:padding="2dp">
                    <Button android:id="@+id/applyFreeCropButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="ثبت محدوده" android:textSize="10sp" android:textColor="#07142F" android:backgroundTint="#A5E6C8" android:minHeight="0dp" android:minWidth="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp">
                    <Button android:id="@+id/hidePlacementOverlayButton" android:layout_width="50dp" android:layout_height="46dp" android:text="×" android:textSize="14sp" android:textColor="#FFFFFF" android:backgroundTint="#B52C45" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/textOverlayPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#172B4D" android:padding="4dp" android:layout_marginTop="3dp" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="متن زنده روی ویدیو" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:gravity="center" />
                    <EditText android:id="@+id/overlayTextInput" android:layout_width="match_parent" android:layout_height="42dp" android:hint="متن را بنویسید؛ هم‌زمان روی پلیر دیده می‌شود" android:singleLine="true" android:inputType="textCapSentences" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="12sp" android:backgroundTint="#D7A6FF" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <EditText android:id="@+id/overlayTextStartTime" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:hint="شروع متن 00:00" android:text="00:00" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="10sp" android:gravity="center" android:backgroundTint="#D7A6FF" />
                        <EditText android:id="@+id/overlayTextEndTime" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="3dp" android:hint="پایان متن" android:text="00:00" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="10sp" android:gravity="center" android:backgroundTint="#D7A6FF" />
                    </LinearLayout>
                    <Button android:id="@+id/finishTextPlacementButton" android:layout_width="match_parent" android:layout_height="40dp" android:text="پایان متن‌گذاری و بستن پنجره" android:textSize="10sp" android:textColor="#07142F" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تنظیمات متن، ویدیوی رویی، صدا، زیرنویس و سایر تغییرات را انجام دهید؛ سپس همهٔ تغییرات پشتیبانی‌شده را با دکمهٔ «خروجی تغییرات» در یک فایل ذخیره کنید." android:textColor="#B9D7FF" android:textSize="9sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="شروع و پایان متن را وارد کنید؛ برای تنظیم جای متن و اندازهٔ متن یا ویدیوی رویی، روی پلیر بکشید و گوشه‌های کادر را تغییر دهید." android:textColor="#B9D7FF" android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/overlayVideoPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#172B4D" android:padding="4dp" android:layout_marginTop="3dp" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ویدیوی رویی" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:gravity="center" />
                    <Button android:id="@+id/pickOverlayVideoButton" android:layout_width="match_parent" android:layout_height="42dp" android:text="انتخاب ویدیوی رویی" android:textSize="10sp" android:textColor="#07142F" android:backgroundTint="#64B5F6" android:minHeight="0dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="پس از انتخاب، ویدیوی رویی مستقیماً روی پلیر فعال می‌شود؛ کادر را بکشید یا گوشه‌ها را تغییر دهید. با برداشتن لمس، تنظیمات ثبت و خروجی تغییرات اجرا می‌شود." android:textColor="#B9D7FF" android:textSize="9sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="فاصلهٔ اسلایدها" android:textColor="#B9D7FF" android:textSize="9sp" android:paddingEnd="5dp" />
                    <EditText android:id="@+id/storyboardIntervalTime" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:hint="اختیاری: ثانیه یا دقیقه:ثانیه" android:text="" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="9sp" android:padding="4dp" android:backgroundTint="#FFD21F" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="خالی = خودکار" android:textColor="#B9D7FF" android:textSize="8sp" android:paddingStart="5dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="2dp">
                    <EditText android:id="@+id/storyboardStartTime" android:layout_width="0dp" android:layout_height="25dp" android:layout_weight="1" android:hint="شروع 00:00" android:text="00:00" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="9sp" android:padding="4dp" android:backgroundTint="#FFD21F" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تا" android:textColor="#B9D7FF" android:paddingStart="4dp" android:paddingEnd="4dp" />
                    <EditText android:id="@+id/storyboardEndTime" android:layout_width="0dp" android:layout_height="25dp" android:layout_weight="1" android:hint="پایان 01:00" android:text="01:00" android:singleLine="true" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:textSize="9sp" android:padding="4dp" android:backgroundTint="#FFD21F" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="1dp" android:paddingBottom="1dp">
                    <TextView android:id="@+id/selectionText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="انتخاب‌شده: ۰ فریم از ۹۰" android:textColor="#FFD21F" android:textSize="9sp" />
                </LinearLayout>
                <TextView android:id="@+id/storyboardScrollHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="استوری‌بورد • همهٔ ۱۲۰ اسلاید در شبکهٔ ثابت نمایش داده می‌شوند؛ برای دیدن ادامه صفحه را عمودی پیمایش کنید" android:textColor="#FFD21F" android:textSize="10sp" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" />
                <LinearLayout android:id="@+id/storyboardRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="4dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="حجم هدف (MB):" android:textColor="#FFFFFF" android:textSize="9sp" />
                    <EditText android:id="@+id/targetSizeMb" android:layout_width="100dp" android:layout_height="25dp" android:layout_marginStart="8dp" android:inputType="numberDecimal" android:singleLine="true" android:text="20" android:textColor="#FFFFFF" android:textColorHint="#B9D7FF" android:hint="مثلاً 20" android:selectAllOnFocus="true" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="6dp" android:text="حجم تقریبی؛ نه تضمین دقیق" android:textColor="#B9D7FF" android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:id="@+id/fixedColorControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#0B1B38" android:elevation="8dp" android:paddingStart="3dp" android:paddingEnd="3dp" android:paddingTop="2dp" android:paddingBottom="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="0dp" android:paddingEnd="0dp">
                <Button android:id="@+id/autoColorButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:text="Auto Color" android:textSize="10sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#43D9A3" android:minHeight="0dp" android:minWidth="0dp" android:paddingLeft="3dp" android:paddingRight="3dp" />
                <Button android:id="@+id/applyColorToSelectedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:paddingLeft="2dp" android:paddingRight="2dp" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:maxLines="1" android:ellipsize="end" android:text="ثبت رنگ برای اسلایدهای انتخابی" android:textSize="9sp" android:textColor="#07142F" android:textStyle="bold" android:backgroundTint="#FFD21F" android:minHeight="0dp" android:minWidth="0dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تنظیم دستی رنگ خروجی (ضریب هر کانال: ۰ تا ۲)" android:textColor="#FFFFFF" android:textSize="9sp" android:gravity="center" android:paddingTop="0dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="3dp">
                    <TextView android:id="@+id/redColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="قرمز 1.00" android:textColor="#FF8A8A" android:textSize="9sp" android:gravity="center" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <SeekBar android:id="@+id/redColorSeek" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:max="200" android:progress="100" android:contentDescription="ضریب کانال قرمز" />
                        <Button android:id="@+id/resetRedColorButton" android:layout_width="42dp" android:layout_height="28dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:text="Rest" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="2dp" android:paddingEnd="2dp">
                    <TextView android:id="@+id/greenColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="سبز 1.00" android:textColor="#8AFFB8" android:textSize="9sp" android:gravity="center" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <SeekBar android:id="@+id/greenColorSeek" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:max="200" android:progress="100" android:contentDescription="ضریب کانال سبز" />
                        <Button android:id="@+id/resetGreenColorButton" android:layout_width="42dp" android:layout_height="28dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:text="Rest" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="3dp">
                    <TextView android:id="@+id/blueColorValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آبی 1.00" android:textColor="#8ABEFF" android:textSize="9sp" android:gravity="center" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <SeekBar android:id="@+id/blueColorSeek" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:max="200" android:progress="100" android:contentDescription="ضریب کانال آبی" />
                        <Button android:id="@+id/resetBlueColorButton" android:layout_width="42dp" android:layout_height="28dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:text="Rest" android:textSize="8sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp">
                <TextView android:id="@+id/saturationValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اشباع رنگ 1.00" android:textColor="#FFD21F" android:textSize="9sp" android:gravity="center" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <SeekBar android:id="@+id/saturationSeek" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:max="200" android:progress="100" android:contentDescription="اشباع رنگ ویدیو از صفر تا دو برابر" />
                    <Button android:id="@+id/resetSaturationButton" android:layout_width="52dp" android:layout_height="32dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingLeft="0dp" android:paddingRight="0dp" android:text="Rest" android:textSize="9sp" android:textColor="#07142F" android:backgroundTint="#FFD21F" />
                </LinearLayout>
            </LinearLayout>
            <Button android:id="@+id/finishColorPanelButton" android:layout_width="match_parent" android:layout_height="36dp" android:minHeight="0dp" android:minWidth="0dp" android:text="پایان تنظیم رنگ و بستن پنجره" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#405A7A" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
